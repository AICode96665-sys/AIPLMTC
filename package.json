{
  "name": "tc-soa-studio",
  "version": "0.1.1",
  "description": "Describe your Teamcenter SOA program in plain English and get the Java — local AI, private by design.",
  "main": "./out/main/index.js",
  "author": "Quick Sense Innovations",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "eval": "esbuild eval/run.ts --bundle --platform=node --outfile=out/eval/run.cjs --log-level=warning && node out/eval/run.cjs",
    "check:recipes": "esbuild eval/recipes.check.ts --bundle --platform=node --outfile=out/eval/recipes.check.cjs --log-level=warning && node out/eval/recipes.check.cjs",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13"
  },
  "build": {
    "appId": "com.quicksense.tcsoastudio",
    "productName": "TC SOA Studio",
    "copyright": "Copyright © 2026 Quick Sense Innovations",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AICode96665-sys/AIPLM.git"
  },
  "homepage": "https://github.com/AICode96665-sys/AIPLM"
}
